"use client";

import { useEffect, useState } from "react";
import { useActionState } from "react";
import { createRT } from "../../penduduk/validation/actions";
import { CreateButton} from "./buttons";
import { startTransition } from "react";

interface WilayahItem {
  id: string;
  name: string;
}

export default function CreateRTFormContainer() {
  const [state, formAction] = useActionState(createRT, null);

  const [provinces, setProvinces] = useState<WilayahItem[]>([]);
  const [regencies, setRegencies] = useState<WilayahItem[]>([]);
  const [districts, setDistricts] = useState<WilayahItem[]>([]);
  const [villages, setVillages] = useState<WilayahItem[]>([]);

  const [provinsi, setProvinsi] = useState("");
  const [kabupaten, setKabupaten] = useState("");
  const [kecamatan, setKecamatan] = useState("");

  // --------------------------
  // FETCH WILAYAH
  // --------------------------
  useEffect(() => {
    fetch("https://www.emsifa.com/api-wilayah-indonesia/api/provinces.json")
      .then((res) => res.json())
      .then(setProvinces)
      .catch(console.error);
  }, []);

  useEffect(() => {
    if (!provinsi) return;
    fetch(`https://www.emsifa.com/api-wilayah-indonesia/api/regencies/${provinsi}.json`)
      .then((res) => res.json())
      .then(setRegencies)
      .catch(console.error);
  }, [provinsi]);

  useEffect(() => {
    if (!kabupaten) return;
    fetch(`https://www.emsifa.com/api-wilayah-indonesia/api/districts/${kabupaten}.json`)
      .then((res) => res.json())
      .then(setDistricts)
      .catch(console.error);
  }, [kabupaten]);

  useEffect(() => {
    if (!kecamatan) return;
    fetch(`https://www.emsifa.com/api-wilayah-indonesia/api/villages/${kecamatan}.json`)
      .then((res) => res.json())
      .then(setVillages)
      .catch(console.error);
  }, [kecamatan]);

  // --------------------------
  // HANDLE SUBMIT
  // --------------------------
  const handleSubmit = (e: React.FormEvent<HTMLFormElement>) => {
    e.preventDefault();
    const formElement = e.currentTarget;
    const formData = new FormData(formElement);

    // Ubah ID jadi nama sebelum submit
    const provinsiName = provinces.find(p => p.id === provinsi)?.name ?? "";
    const kabupatenName = regencies.find(r => r.id === kabupaten)?.name ?? "";
    const kecamatanName = districts.find(d => d.id === kecamatan)?.name ?? "";
    const desaName = villages.find(v => v.id === formData.get("desa"))?.name ?? "";

    formData.set("provinsi", provinsiName);
    formData.set("kabupaten", kabupatenName);
    formData.set("kecamatan", kecamatanName);
    formData.set("desa", desaName);

    startTransition(() => {
    formAction(formData);
  });
  };


  return (
    <div className="max-w-2xl mx-auto bg-white dark:bg-slate-900 p-6 rounded-2xl shadow-md">
      <h2 className="text-xl font-semibold mb-6">Tambah RT Baru</h2>

       <form onSubmit={handleSubmit} className="grid grid-cols-1 md:grid-cols-2 gap-4">
        {/* ----- INPUT DASHBOARD ----- */}

        {/* Nomor RT */}
        <div>
          <label className="block text-sm font-medium mb-1">Nomor RT</label>
          <input
            type="text"
            name="nomor_rt"
            id="nomor_rt"
            placeholder="01"
            className="w-full border rounded-lg p-2 focus:ring-2 focus:ring-blue-400"
          />
          <p className="text-sm text-red-500">{state?.Error?.nomor_rt}</p>
        </div>

        {/* NIK */}
        <div>
          <label className="block text-sm font-medium mb-1">NIK Ketua RT</label>
          <input
            type="text"
            name="nik"
            id="nik"
            maxLength={16}
            placeholder="Masukkan NIK"
            className="w-full border rounded-lg p-2 focus:ring-2 focus:ring-blue-400"
          />
          <p className="text-sm text-red-500">{state?.Error?.nik}</p>
        </div>

        {/* Nama */}
        <div>
          <label className="block text-sm font-medium mb-1">
            Nama Ketua RT
          </label>
          <input
            type="text"
            name="nama"
            id="nama"
            placeholder="Masukkan Nama"
            className="w-full border rounded-lg p-2 focus:ring-2 focus:ring-blue-400"
          />
          <p className="text-sm text-red-500">{state?.Error?.nama}</p>
        </div>

        {/* Nomor HP */}
        <div>
          <label className="block text-sm font-medium mb-1">Nomor HP</label>
          <input
            type="text"
            name="no_hp"
            id="no_hp"
            placeholder="08xxxxxxxxxx"
            className="w-full border rounded-lg p-2 focus:ring-2 focus:ring-blue-400"
          />
          <p className="text-sm text-red-500">{state?.Error?.no_hp}</p>
        </div>

        {/* Alamat */}
        <div>
          <label className="block text-sm font-medium mb-1">Alamat</label>
          <input
            type="text"
            id= "alamat"
            name="alamat"
            placeholder="Masukkan alamat..."
            className="w-full border rounded-lg p-2 focus:ring-2 focus:ring-blue-400"
          />
          <p className="text-sm text-red-500">{state?.Error?.alamat}</p>
        </div>

         {/* Kode Pos */}
        <div>
        <label className="block text-sm font-medium mb-1">Kode Pos</label>
          <input
            type="text"
            name="kode_pos"
            id="kode_pos"
            placeholder="Masukkan Kode Pos..."
            className="w-full border rounded-lg p-2 focus:ring-2 focus:ring-blue-400"
          />
          <p className="text-sm text-red-500">{state?.Error?.alamat}</p>
        </div>

        {/* ----- WILAYAH ----- */}

        {/* Provinsi */}
        <div>
          <label className="block text-sm font-medium mb-1">Provinsi</label>
          <select
            name="provinsi"
            value={provinsi}
            onChange={(e) => setProvinsi(e.target.value)}
            className="w-full border p-2 rounded-lg"
          >
            <option value="">Pilih Provinsi</option>
            {provinces.map((p) => (
              <option key={p.id} value={p.id}>
                {p.name}
              </option>
            ))}
          </select>
        </div>

        {/* Kabupaten */}
        <div>
          <label className="block text-sm font-medium mb-1">Kabupaten</label>
          <select
            name="kabupaten"
            value={kabupaten}
            onChange={(e) => setKabupaten(e.target.value)}
            className="w-full border p-2 rounded-lg"
          >
            <option value="">Pilih Kabupaten</option>
            {regencies.map((r) => (
              <option key={r.id} value={r.id}>
                {r.name}
              </option>
            ))}
          </select>
        </div>

        {/* Kecamatan */}
        <div>
          <label className="block text-sm font-medium mb-1">Kecamatan</label>
          <select
            name="kecamatan"
            value={kecamatan}
            onChange={(e) => setKecamatan(e.target.value)}
            className="w-full border p-2 rounded-lg"
          >
            <option value="">Pilih Kecamatan</option>
            {districts.map((d) => (
              <option key={d.id} value={d.id}>
                {d.name}
              </option>
            ))}
          </select>
        </div>

        {/* Desa */}
        <div>
          <label className="block text-sm font-medium mb-1">
            Desa / Kelurahan
          </label>
          <select name="desa" className="w-full border p-2 rounded-lg">
            <option value="">Pilih Desa</option>
            {villages.map((v) => (
              <option key={v.id} value={v.id}>
                {v.name}
              </option>
            ))}
          </select>
        </div>

        {/* SUBMIT */}
        <div className="md:col-span-2 flex justify-end pt-4">
          <CreateButton />
        </div>
      </form>
    </div>
  );
}
